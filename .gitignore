# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]

# --- large local artifacts (keep out of git) ---
question-bank-seed.sql
vocab-seed.sql
question-bank.json
question-bank.json.part.jsonl
question-media.jsonl
active-questions.json
vocab.json
Practise tests/
question banks/
Resoure for study/
Vocabulary/

# NOTE: sat-corpus.json and sat-corpus-official.json are deliberately tracked.
# src/lib/ai/knowledge.ts reads them from disk at runtime (the book-retrieval
# fallback used when no SAT_AI_API_KEY is set) and next.config.ts traces them
# into the serverless bundle via outputFileTracingIncludes. See the matching
# note in .vercelignore.
